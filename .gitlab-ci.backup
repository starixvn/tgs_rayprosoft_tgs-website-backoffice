variables:
  Registry: "pgtgs/"
  Image: "backoffice-site"

stages:
  - build
  - deploy

docker_build:
  stage: build
  image: pgtgs/tgs-lobby-build:latest
  tags:
    - saas-linux-xlarge-amd64
  services:
    - docker:20.10.16-dind
  variables:
    DOCKER_DRIVER: overlay2
    DOCKER_TLS_CERTDIR: ""
    DOCKER_HOST: tcp://docker:2375
    GIT_STRATEGY: clone
  script:
    - docker info
    - docker login --username $docker_user --password $docker_token
    - export TAG=$(date +%Y-%m%d-%H%M)
    - echo $TAG > tag.txt
    - docker build -t ${Registry}${Image}:${TAG} .
    - docker push ${Registry}${Image}:${TAG}
  artifacts:
    paths:
      - tag.txt
  only:
    - main
    - release
    - develop

.deploy_template: &deploy_template
  stage: deploy
  image:
    name: bitnami/kubectl:1.30
    entrypoint: [""]
  before_script:
    - TAG=$(cat tag.txt)
  script:
    - kubectl set image deployment/${Image} ${Image}=${Registry}${Image}:${TAG} --record -n ${CI_ENVIRONMENT_NAME}
  dependencies:
    - docker_build

deploy-dev:
  <<: *deploy_template
  tags:
    - dev
  variables:
    CI_ENVIRONMENT_NAME: dev
  only:
    - develop

deploy-staging:
  <<: *deploy_template
  tags:
    - staging
  variables:
    CI_ENVIRONMENT_NAME: staging
  only:
    - release

deploy-prod:
  <<: *deploy_template
  tags:
    - prod
  variables:
    CI_ENVIRONMENT_NAME: prod
  when: manual
  only:
    - main